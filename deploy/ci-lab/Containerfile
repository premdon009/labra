# The local lab for one portability row (scripts/ci_portability.sh): Ubuntu 26.04 like GitHub's
# runner, systemd as PID 1 so Podman's health checks, its socket and rootless containerd run as
# user services, and a sudo user `runner`. Docker comes from the Ubuntu archive, so its version
# differs from the runner's. Every engine and package a row installs is here already, so a row's
# --install step needs no network (docs/dev/runtimes.md).
FROM ghcr.io/astral-sh/uv:0.12.18@sha256:3adc3706091ce7c2fe595e669628caedd6d951551b92b258b7e7dbe06d9440bc AS uv

FROM docker.io/library/ubuntu:26.04@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944
COPY --from=uv /uv /uvx /usr/local/bin/
ENV DEBIAN_FRONTEND=noninteractive
# Recommended packages too, as the runner's `apt-get install` brings them (aardvark-dns gives
# Podman's networks their names). Docker Desktop's network drops an apt request now and then
# (docs/dev/tooling-issues.md).
RUN printf 'Acquire::Retries "5";\nAcquire::http::Pipeline-Depth "0";\n' \
      >/etc/apt/apt.conf.d/80-retries \
 && for try in 1 2 3 4 5; do \
      apt-get update && apt-get install -y \
        systemd systemd-sysv dbus dbus-user-session sudo ca-certificates curl git openssl \
        python3 iproute2 iptables uidmap passt fuse-overlayfs apparmor \
        docker.io docker-compose-v2 docker-buildx \
        podman podman-compose buildah \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libharfbuzz-subset0 fontconfig \
      && break; \
      [ "$try" = 5 ] && exit 1; sleep 5; \
    done \
 && rm -rf /var/lib/apt/lists/*
# Containers inside need / shared, or Podman warns and some mounts go missing.
RUN printf '[Unit]\nDescription=Make / a shared mount\n[Service]\nType=oneshot\nExecStart=/usr/bin/mount --make-rshared /\n[Install]\nWantedBy=multi-user.target\n' \
      >/etc/systemd/system/rshared.service \
 && systemctl enable rshared.service \
 && useradd -m -s /bin/bash -G docker runner \
 && echo 'runner ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/runner \
 && mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/runner
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
