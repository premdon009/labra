# Only pyproject.toml, uv.lock, README.md, LICENSE, CHANGELOG.md, src/ and the user manual
# (docs/manual/ and zensical.toml, for the help pages inside the app) go into the image.
*
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!CHANGELOG.md
!src/
!zensical.toml
!docs/manual/
**/__pycache__
**/*.pyc
